<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Horilla Test Suite">
    <listeners>
        <listener class-name="horilla.TestObjects.Listeners"></listener>
    </listeners>
    <test verbose="1" parallel="false" preserve-order="true" name="Sequential Execution">


    <classes>
        <class name="horilla.tests.LoginTest">
            <methods><include name="loginHorilla"/></methods>
        </class>
        <class name="horilla.tests.NewRecruitment">
            <methods><include name="Recruitments"/></methods>
        </class>
    </classes></test></suite>